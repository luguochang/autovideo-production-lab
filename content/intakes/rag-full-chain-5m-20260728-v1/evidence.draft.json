    },
    {
      "id": "claim-hybrid-fusion-rerank",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "生产检索通常组合语义召回和关键词召回，再用排名融合与精排收窄候选。",
      "citations": [
        {
          "id": "citation-hybrid-retrieval",
          "sourceId": "source-001-41d218d3",
          "quote": "所以生产上几乎都上 hybrid,补 BM25 关键词路。",
          "locator": {"scheme": "line-range", "startLine": 128, "endLine": 128, "occurrence": 1}
        },
        {
          "id": "citation-rank-fusion",
          "sourceId": "source-001-41d218d3",
          "quote": "RRF 只用排名,尺度无关,简单鲁棒,像多评委投票不比绝对分比平均名次。",
          "locator": {"scheme": "line-range", "startLine": 144, "endLine": 144, "occurrence": 1}
        },
        {
          "id": "citation-rerank-distinction",
          "sourceId": "source-001-41d218d3",
