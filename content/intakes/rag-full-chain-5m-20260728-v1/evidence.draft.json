  "claims": [
    {
      "id": "claim-main-dataflow",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "RAG 全链路可以按离线建库、在线检索、Agentic 决策和评测闭环来理解。",
      "citations": [
        {
          "id": "citation-main-flow",
          "sourceId": "source-001-41d218d3",
          "quote": "整个链路分两段:离线建库把文档变成可检索的库,在线检索把 query 变成答案,中间 Agentic 决策是分水岭。",
          "locator": {"scheme": "line-range", "startLine": 20, "endLine": 20, "occurrence": 1}
        },
        {
          "id": "citation-evaluation-loop",
          "sourceId": "source-001-41d218d3",
          "quote": "不评测的 RAG 就是瞎调,每改一环都要有指标量化。评测贯穿全链路。",
          "locator": {"scheme": "line-range", "startLine": 204, "endLine": 204, "occurrence": 1}
        }
      ],
      "protectedAtomIds": [],
      "notes": "作为完整长版的主线主张；外部数字和项目效果数字仍作为证据缺口，未完成来源或授权处理前不得用于公开结论。"
    },
    {
      "id": "claim-parsing-layered",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "生产文档解析应采用主解析、规则清洗和困难页面兜底的分层组合。",
      "citations": [
        {
          "id": "citation-parsing-layered",
          "sourceId": "source-001-41d218d3",
          "quote": "生产上几乎不会单一用一个解析器,而是**分层组合**。",
          "locator": {"scheme": "line-range", "startLine": 32, "endLine": 32, "occurrence": 1}
        }
      ],
      "protectedAtomIds": [],
      "notes": "具体解析器名称留在屏幕选型摘要，不进入主张。"
    },
    {
      "id": "claim-chunk-by-document",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "分块策略应随文档类型变化，并保留来源、章节、页码和版本等元数据。",
      "citations": [
        {
          "id": "citation-chunk-strategy",
          "sourceId": "source-001-41d218d3",
          "quote": "生产上一般**按文档类型分策略**,不是全局一个切法。",
          "locator": {"scheme": "line-range", "startLine": 48, "endLine": 48, "occurrence": 1}
        },
        {
          "id": "citation-chunk-metadata",
          "sourceId": "source-001-41d218d3",
          "quote": "而且切完每个 chunk 必须绑元数据--来源、章节、页码、条文号、版本,这些后面条件过滤、引用展示、索引重建全要用。",
          "locator": {"scheme": "line-range", "startLine": 48, "endLine": 48, "occurrence": 1}
        }
      ],
      "protectedAtomIds": [],
      "notes": "检索块与合成块解耦作为画面辅助关系，不展开品牌框架。"
    },
    {
      "id": "claim-context-enhancement",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "分块后、向量化前可增加上下文增强，使片段脱离原文后仍更容易被正确理解。",
      "citations": [
        {
          "id": "citation-context-stage",
          "sourceId": "source-001-41d218d3",
          "quote": "分块后、向量化前,其实可以插一步上下文增强。",
          "locator": {"scheme": "line-range", "startLine": 58, "endLine": 58, "occurrence": 1}
        }
      ],
      "protectedAtomIds": [],
      "notes": "不采用原稿中的外部提升百分比。"
    },
    {
      "id": "claim-model-index-selection",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "向量模型和索引的生产选择，应同时考虑中文效果、数据边界、数据规模和运维成本。",
      "citations": [
        {
          "id": "citation-embedding-considerations",
          "sourceId": "source-001-41d218d3",
          "quote": "**生产怎么选、为什么**,三个考量。一是中文效果",
          "locator": {"scheme": "line-range", "startLine": 80, "endLine": 80, "occurrence": 1}
        },
        {
          "id": "citation-index-considerations",
          "sourceId": "source-001-41d218d3",
          "quote": "核心看三件事:规模、是否要事务和 join、运维成本。",
          "locator": {"scheme": "line-range", "startLine": 96, "endLine": 96, "occurrence": 1}
        }
      ],
      "protectedAtomIds": [],
      "notes": "产品名和具体维度不进入生产旁白。"
    },
    {
      "id": "claim-query-routing",
      "claimKind": "source-opinion",
      "supportStatus": "supported",
      "statement": "在线查询应先判断复杂度，再按需执行改写、多路或多跳检索。",
      "citations": [
        {
          "id": "citation-query-routing",
          "sourceId": "source-001-41d218d3",
          "quote": "生产上是**路由判断 + 按需改写**的组合。",
          "locator": {"scheme": "line-range", "startLine": 114, "endLine": 114, "occurrence": 1}
        }
      ],
      "protectedAtomIds": [],
