{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovideo.local/schema/style-selection.json",
  "title": "AutoVideo Style Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "baseStyleId", "addons", "registryItems", "blueprints", "motionRules", "status", "receipts"],
  "properties": {
    "schemaVersion": {"const": "autovideo-style-selection/v1"},
    "projectId": {"type": "string", "minLength": 1},
    "narrationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseStyleId": {"type": "string", "minLength": 1},
    "framePreset": {"type": ["string", "null"]},
    "addons": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "registryItems": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "blueprints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "motionRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["draft", "approved", "rejected"]},
    "approvedBy": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "kind", "license"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "kind": {"enum": ["official", "community", "user-provided", "project-local"]},
          "license": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {"required": ["approvedBy"], "properties": {"approvedBy": {"type": "string", "minLength": 1}}}
    }
  ]
}
