{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovideo.local/schema/motion-recipe-lifecycle.json",
  "title": "AutoVideo Motion Recipe Lifecycle Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "library", "invariants", "catalogBindings", "policy", "entries"],
  "properties": {
    "schemaVersion": {"const": "autovideo-motion-recipe-lifecycle/v1"},
    "library": {"$ref": "#/$defs/libraryBinding"},
    "invariants": {"$ref": "#/$defs/invariants"},
    "catalogBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialRegistry", "officialBlueprints", "officialMotionRules"],
      "properties": {
        "officialRegistry": {"$ref": "#/$defs/fileBinding"},
        "officialBlueprints": {"$ref": "#/$defs/fileBinding"},
        "officialMotionRules": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "probeDurationSeconds", "minimumProjectApprovalsForTemplate", "humanApprovalRequiredFor", "retirementIsTerminal", "officialReuseOrder", "existingLockedProjectsMayReplayRetiredVersions"],
      "properties": {
        "states": {"const": ["candidate", "probe-passed", "approved-project", "promoted-template", "retired"]},
        "probeDurationSeconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {"minimum": {"const": 3}, "maximum": {"const": 8}}
        },
        "minimumProjectApprovalsForTemplate": {"type": "integer", "minimum": 2},
        "humanApprovalRequiredFor": {"const": ["approved-project", "promoted-template", "retired"]},
        "retirementIsTerminal": {"const": true},
        "officialReuseOrder": {"const": ["official-registry", "official-blueprint", "official-motion-rule", "project-local"]},
        "existingLockedProjectsMayReplayRetiredVersions": {"const": true}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "libraryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {"const": "knowledge-explainer"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "path": {"const": "style-library/motion-library/knowledge-explainer-v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseStyleId", "baseStyleVersion", "paletteId", "background", "hostZone", "contentZone", "captionZone", "cameraScope", "hostReplacementAllowed", "paletteReplacementAllowed"],
      "properties": {
        "baseStyleId": {"const": "modern-ip-host-explainer"},
        "baseStyleVersion": {"const": "1.0.0"},
        "paletteId": {"const": "light-apricot"},
        "background": {"const": "#F2DFC7"},
        "hostZone": {"const": "host.left"},
        "contentZone": {"const": "content.right"},
        "captionZone": {"const": "caption"},
        "cameraScope": {"const": "content-world-only"},
        "hostReplacementAllowed": {"const": false},
        "paletteReplacementAllowed": {"const": false}
      }
    },
    "projectApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "approvedBy", "approvedAt", "styleSelection", "probeReceipt"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAt": {"type": "string", "format": "date-time"},
        "styleSelection": {"$ref": "#/$defs/fileBinding"},
        "probeReceipt": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "retirement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "replacementRecipeId", "retiredBy", "retiredAt", "existingProjectReplayAllowed", "futureSelectionBlocked"],
      "properties": {
        "reason": {"enum": ["visual-regression", "semantic-regression", "determinism-regression", "accessibility-regression", "rights-or-license-blocked", "official-source-removed", "superseded-by-new-version", "template-incompatibility"]},
        "replacementRecipeId": {"type": ["string", "null"]},
        "retiredBy": {"type": "string", "minLength": 1},
        "retiredAt": {"type": "string", "format": "date-time"},
        "existingProjectReplayAllowed": {"const": true},
        "futureSelectionBlocked": {"const": true}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "recipeVersion", "definitionSha256", "state", "revision", "receiptRefs", "projectApprovals", "retirement"],
      "properties": {
        "recipeId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "recipeVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "definitionSha256": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["candidate", "probe-passed", "approved-project", "promoted-template", "retired"]},
        "revision": {"type": "integer", "minimum": 0},
        "receiptRefs": {"type": "array", "items": {"$ref": "#/$defs/fileBinding"}},
        "projectApprovals": {"type": "array", "items": {"$ref": "#/$defs/projectApproval"}},
        "retirement": {"$ref": "#/$defs/retirement"}
      }
    }
  }
}
