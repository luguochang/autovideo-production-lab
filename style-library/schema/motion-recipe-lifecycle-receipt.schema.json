{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovideo.local/schema/motion-recipe-lifecycle-receipt.json",
  "title": "AutoVideo Motion Recipe Lifecycle Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "action", "outcome", "createdAt", "actor", "library", "recipe", "fromState", "requestedState", "effectiveState", "invariantSnapshot", "evidence", "gateResults", "blockedReasons"],
  "properties": {
    "schemaVersion": {"const": "autovideo-motion-recipe-lifecycle-receipt/v1"},
    "receiptId": {"type": "string", "minLength": 1},
    "action": {"enum": ["transition", "retire"]},
    "outcome": {"enum": ["applied", "blocked"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "library": {"$ref": "https://autovideo.local/schema/motion-recipe-lifecycle.json#/$defs/libraryBinding"},
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "definitionSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "definitionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "fromState": {"enum": ["candidate", "probe-passed", "approved-project", "promoted-template", "retired"]},
    "requestedState": {"enum": ["probe-passed", "approved-project", "promoted-template", "retired"]},
    "effectiveState": {"enum": ["candidate", "probe-passed", "approved-project", "promoted-template", "retired"]},
    "invariantSnapshot": {"$ref": "https://autovideo.local/schema/motion-recipe-lifecycle.json#/$defs/invariants"},
    "evidence": {"$ref": "https://autovideo.local/schema/motion-recipe-lifecycle-evidence.json"},
    "gateResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "details": {}
        }
      }
    },
    "blockedReasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "applied"}}},
      "then": {"properties": {"blockedReasons": {"type": "array", "maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "blocked"}}},
      "then": {"properties": {"blockedReasons": {"type": "array", "minItems": 1}}}
    }
  ]
}
