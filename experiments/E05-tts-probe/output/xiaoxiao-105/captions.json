    "duration": 0.9982806747967743,
    "end": 289.24920470406505,
    "timingSource": "sentence-boundary-proportional"
  },
  {
    "sentenceIndex": 45,
    "text": "如何去维护，",
    "start": 289.24920470406505,
    "duration": 0.9982806747967743,
    "end": 290.2474853788618,
    "timingSource": "sentence-boundary-proportional"
  },
  {
    "sentenceIndex": 45,
    "text": "如何去负责，",
