{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo workbench beat draft",
  "type": "object",
  "required": ["schemaVersion", "beats"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "autovideo-storyboard-beats/v1"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "exactExcerpt", "screenText", "screenTextKind", "claimIds", "visualType", "startAnchor", "endAnchor", "nodes", "edges"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "exactExcerpt": {"type": "string"},
          "screenText": {"type": "string"},
          "screenTextKind": {"type": "string", "enum": ["exact_excerpt", "generated_summary"]},
          "claimIds": {"type": "array", "items": {"type": "string"}},
          "visualType": {"type": "string", "enum": ["host_explain", "process_flow", "compare", "evidence", "diagram", "quote", "summary"]},
          "startAnchor": {"type": "string"},
          "endAnchor": {"type": "string"},
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "label": {"type": "string"},
                "kind": {"type": "string"}
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "from", "to"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "from": {"type": "string"},
                "to": {"type": "string"},
                "label": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
