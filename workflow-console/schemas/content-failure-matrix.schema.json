{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo synthetic content failure matrix",
  "type": "object",
  "required": ["schemaVersion", "datasetClass", "cases", "humanGoldEligible"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "autovideo-content-failure-matrix/v1"},
    "datasetClass": {"type": "string", "const": "synthetic-contract-matrix"},
    "humanGoldEligible": {"type": "boolean", "const": false},
    "cases": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": ["caseId", "topicClass", "mutation", "expectedIssueCodes"],
        "additionalProperties": false,
        "properties": {
          "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "topicClass": {"type": "string", "minLength": 1},
          "mutation": {"type": "string", "minLength": 1},
          "expectedIssueCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
