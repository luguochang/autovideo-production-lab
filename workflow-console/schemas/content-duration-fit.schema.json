{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo deterministic content duration assessment",
  "type": "object",
  "required": [
    "schemaVersion", "projectId", "spokenRewriteSha256", "ruleVersion", "status",
    "modifiesWording", "targetSeconds", "toleranceSeconds", "budgetSeconds",
    "narrationGraphemes", "graphemesPerSecond", "acceptedDensityBand", "sections",
    "issues", "assessedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "autovideo-content-duration-fit/v1"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "spokenRewriteSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ruleVersion": {"type": "string", "const": "zh-cn-text-budget-v1"},
    "status": {"type": "string", "enum": ["passed", "needs-revision"]},
    "modifiesWording": {"type": "boolean", "const": false},
    "targetSeconds": {"type": "number", "minimum": 1},
    "toleranceSeconds": {"type": "number", "minimum": 0},
    "budgetSeconds": {"type": "number", "minimum": 1},
    "narrationGraphemes": {"type": "integer", "minimum": 1},
    "graphemesPerSecond": {"type": "number", "minimum": 0},
    "acceptedDensityBand": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": {"type": "number", "const": 3.2},
        "max": {"type": "number", "const": 8}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "targetSeconds", "graphemes", "graphemesPerSecond", "passed"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "targetSeconds": {"type": "number", "minimum": 1},
          "graphemes": {"type": "integer", "minimum": 1},
          "graphemesPerSecond": {"type": "number", "minimum": 0},
          "passed": {"type": "boolean"}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"},
          "sectionId": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "assessedAt": {"type": "string", "minLength": 1}
  }
}
