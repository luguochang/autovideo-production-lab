{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo registered content sources",
  "type": "object",
  "required": ["schemaVersion", "projectId", "root", "generatedAt", "sources", "skipped", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "autovideo-sources/v1"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "root": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "type", "bytes", "modifiedAt", "sha256", "source", "license", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "modifiedAt": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"type": "string", "const": "user-provided"},
          "license": {"type": "string", "minLength": 1},
          "status": {"type": "string", "const": "registered"}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
