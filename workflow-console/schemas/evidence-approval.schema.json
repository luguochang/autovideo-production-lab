{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo human evidence approval",
  "type": "object",
  "required": [
    "schemaVersion", "projectId", "evidence", "sourcesSha256", "suitabilitySha256",
    "status", "approvalScope", "approvedBy", "approvedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "autovideo-evidence-approval/v1"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "evidence": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "const": "evidence.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "sourcesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "suitabilitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "const": "approved"},
    "approvalScope": {"type": "string", "const": "human-review"},
    "approvedBy": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "minLength": 1}
  }
}
