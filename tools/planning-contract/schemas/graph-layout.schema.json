{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovideo.local/schema/graph-layout.schema.json",
  "title": "AutoVideo Editable Graph Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "generatedAt", "planning", "diagrams"],
  "properties": {
    "schemaVersion": {"const": "autovideo-graph-layout/v1"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "planning": {"type": "object", "additionalProperties": true},
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graphId", "beatId", "source", "layout"],
        "properties": {
          "graphId": {"type": "string", "minLength": 1},
          "beatId": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "layout": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "children", "edges", "x", "y", "width", "height"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["id", "width", "height", "x", "y"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "width": {"type": "number", "exclusiveMinimum": 0},
                    "height": {"type": "number", "exclusiveMinimum": 0},
                    "x": {"type": "number"},
                    "y": {"type": "number"}
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["id", "sources", "targets"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
