{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovideo.local/schema/graph-ir.schema.json",
  "title": "AutoVideo Graph IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "purpose", "globalPolicy", "graphs"],
  "properties": {
    "schemaVersion": {"const": "autovideo-graph-ir/v1"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "purpose": {"type": "string", "minLength": 1},
    "globalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxActiveNodesPerState",
        "defaultStateTransition",
        "completedGroupTreatment",
        "allowedMotionRules",
        "forbidGraphKinds",
        "excludedNumericClaims",
        "numericClaimReason"
      ],
      "properties": {
        "maxActiveNodesPerState": {"type": "integer", "minimum": 1},
        "defaultStateTransition": {"type": "string", "minLength": 1},
        "completedGroupTreatment": {"type": "string", "minLength": 1},
        "allowedMotionRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidGraphKinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excludedNumericClaims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "numericClaimReason": {"type": "string", "minLength": 1}
      }
    },
    "graphs": {"type": "array", "items": {"$ref": "#/$defs/graph"}},
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "cueId": {"type": "string", "pattern": "^cue-[0-9]{3,}$"},
    "sceneId": {"type": "string", "pattern": "^scene-[0-9]{2,}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "cueIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/cueId"}},
    "visualType": {
      "enum": ["keyword", "evidence-image", "device-surface", "diagram", "data-proof", "comparison", "code-surface", "object-metaphor"]
    },
    "motionRecipeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["libraryId", "libraryVersion", "recipeId", "version", "params", "sourceCueIds"],
      "properties": {
        "libraryId": {"type": "string", "minLength": 1},
        "libraryVersion": {"type": "string", "minLength": 1},
        "recipeId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "params": {"type": "object", "additionalProperties": true},
        "sourceCueIds": {"$ref": "#/$defs/cueIds"}
      }
    },
    "cueDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cueId", "visualType", "motionRecipeRefs", "assetRefs", "sfxRefs", "provenanceRefs"],
      "properties": {
        "cueId": {"$ref": "#/$defs/cueId"},
        "visualType": {"$ref": "#/$defs/visualType"},
        "motionRecipeRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/motionRecipeRef"}},
        "assetRefs": {"type": "array", "items": {"type": "object"}},
        "carrierPayload": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "sfxRefs": {"type": "array", "items": {"type": "object"}},
        "provenanceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "textType", "sourceCueIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "textType": {"enum": ["exact-source", "approved-summary", "generated-summary"]},
        "sourceCueIds": {"$ref": "#/$defs/cueIds"},
        "generationReceipt": {"type": "string", "minLength": 1},
        "approvalReceipt": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "relation": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cueIds", "operation", "activeNodeIds", "activeEdgeIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "cueIds": {"$ref": "#/$defs/cueIds"},
        "operation": {"enum": ["replace", "compact"]},
        "activeNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "activeEdgeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "compactedNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sceneId", "kind", "sourceCueIds", "nodes", "edges", "states", "terminalStateId", "motionRules"],
      "properties": {
        "id": {"type": "string", "pattern": "^graph-[a-z0-9-]+$"},
        "sceneId": {"$ref": "#/$defs/sceneId"},
        "kind": {"type": "string", "minLength": 1},
        "sourceCueIds": {"$ref": "#/$defs/cueIds"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}},
        "terminalStateId": {"$ref": "#/$defs/id"},
        "motionRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cueDirectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cueDirective"}}
      }
    }
  }
}
